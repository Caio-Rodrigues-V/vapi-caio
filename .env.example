NODE_ENV=production
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

OPENAI_API_KEY=

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

WORKER_TRIGGER_TOKEN=
WORKER_BATCH_SIZE=5
WORKER_MAX_TRIES=5
WORKER_RETRY_DELAY_MS=60000
WORKER_STALE_LOCK_MINUTES=15
BUSINESS_TIMEZONE=America/Sao_Paulo

# Base pública usada no build do frontend.
# No cPanel atual: /vapi/
# Em um futuro subdomínio na raiz: /
VITE_BASE_PATH=/vapi/

# Opcional. Separe múltiplas origens por vírgula.
# Exemplo: https://grupoddm.ia.br
CORS_ORIGINS=https://grupoddm.ia.br
