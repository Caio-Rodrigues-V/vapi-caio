# Configurações de Email (SMTP)
SMTP_HOST=mail.ddm.adv.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DDM Assessoria" <atendimento@ddm.adv.br>

# Opcional. Webhook do n8n para envio de acordos
N8N_WEBHOOK_URL=

# Redirecionamento de Email/Telefone para Testes (Debug)
DEBUG_EMAIL_RECIPIENT=
DEBUG_PHONE_RECIPIENT=

