NODE_ENV=production
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Mantido enquanto o backend ainda classifica o resultado do webhook.
OPENAI_API_KEY=

# Operação UVA
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID_UVA=

DDM_BASE_URL=https://ddmacordos.com
DDM_TOKEN=
DDM_TOKEN_BUSCA=
DDM_TIMEOUT_MS=7000
DDM_MAX_RETRIES=3

API_AUTH_TOKEN=
WORKER_TRIGGER_TOKEN=
ADMIN_MIGRATION_TOKEN=

GLOBAL_MAX_CONCURRENT=10
WORKER_CAMPAIGN_SCAN_LIMIT=20
WORKER_BATCH_SIZE=5
WORKER_MAX_TRIES=5
WORKER_RETRY_BASE_MS=60000
WORKER_RETRY_MAX_MS=3600000
WORKER_RETRY_JITTER_RATIO=0.2
WORKER_STALE_LOCK_MINUTES=15
WORKER_WATCHDOG_TIMEOUT_MINUTES=8
WORKER_DELAY_BETWEEN_CALLS_MS=1000

BUSINESS_TIMEZONE=America/Sao_Paulo

# Base pública usada no build do frontend.
VITE_BASE_PATH=/

# Opcional. Separe múltiplas origens por vírgula.
