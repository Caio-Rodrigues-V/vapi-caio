{
  "name": "vapi-caio",
  "version": "1.0.0",
  "description": "Disparador automático de chamadas com Vapi, Node.js e MySQL",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node app.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "db:setup": "node dist/setupDb.js",
    "db:setup:dev": "tsx src/setupDb.ts",
    "start:poc": "tsx src/poc.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "npm run build"
  },
  "keywords": [
    "vapi",
    "dialer",
    "typescript",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "openai": "^7.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
