{
  "name": "vapi-caio",
  "version": "1.0.0",
  "description": "Disparador automático de chamadas com Vapi, Node.js e MySQL",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('frontend/dist',{recursive:true,force:true});\"",
    "frontend:install": "npm --prefix frontend ci --include=dev",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "start": "node app.js",
    "worker": "tsx src/worker.ts",
    "worker:campaigns": "tsx src/workers/campaignDispatcher.ts",
    "db:setup": "tsx src/setupDb.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix frontend run build -- --emptyOutDir=false"
  },
  "keywords": ["vapi", "dialer", "typescript", "mysql"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "openai": "^7.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
